{
  "name": "map-data-front",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "concurrently -k -n FRONT,API -c blue,green \"npm:dev:front\" \"npm:dev:api\"",
    "dev:front": "nuxt dev",
    "dev:api": "bash -c 'touch data/__init__.py && source .venv/bin/activate && uvicorn data.api:app --reload --port 8000'",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "nuxt": "^4.4.2",
    "vue": "^3.5.30",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "concurrently": "^9.2.1"
  }
}